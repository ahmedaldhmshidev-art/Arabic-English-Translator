<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <!-- النص الأصلي -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/etEnterTextOriginal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTranslatedTextIdFragShow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:maxLines="6"
            android:gravity="top|start"
            />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- زر نطق النص الأصلي -->
    <ImageView
        android:id="@+id/btnSpeakInputIdFragShow"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/icon_speak"
        android:contentDescription="@string/imgSpeakOriginal"
        app:layout_constraintBottom_toBottomOf="@id/til_input"
        app:layout_constraintEnd_toEndOf="@id/til_input"
        android:layout_margin="8dp"
        />

    <!-- سطر اللغات -->
    <LinearLayout
        android:id="@+id/langRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/til_input"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/tvFromIdFragShow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tvFromLanguage"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <ImageView
            android:id="@+id/btnSwapFragShow"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginHorizontal="16dp"
            android:src="@drawable/baseline"
            android:contentDescription="@string/imgChangeLanguage"/>

        <TextView
            android:id="@+id/tvToIdFragShow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tvToLanguage"
            android:textStyle="bold"
            android:textSize="16sp"/>
    </LinearLayout>

    <!-- كرت الترجمة -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardResult"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardElevation="4dp"
        app:cardCornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/langRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="15dp"
            >

            <TextView
                android:id="@+id/tvShowTranslatedTextIdFragShow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/tvShowTextTranslated"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="10"
                android:ellipsize="end"
                android:textIsSelectable="true"

                />

            <ImageView
                android:id="@+id/btnSpeakOutputIdFragShow"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="false"
                android:layout_marginTop="4dp"
                android:src="@drawable/icon_speak"
                android:contentDescription="@string/imgSpeak"/>
        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- زر حذف السجل -->
    <TextView
        android:id="@+id/btnClearHistory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btnDeleteTheRecord"
        android:textColor="@android:color/holo_red_dark"
        android:textStyle="bold"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/cardResult"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="18dp"
        />

    <!-- RecyclerView سجل الترجمات -->
    <androidx.recyclerview.widget.RecyclerView

        android:id="@+id/rvHistory"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/btnClearHistory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
