<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_host"
    app:startDestination="@id/showTranslated">

    <fragment
        android:id="@+id/showTranslated"
        android:name="com.example.translatelanguages.ShowTranslated"
        android:label="fragment_show_translated"
        tools:layout="@layout/fragment_show_translated" >
        <action
            android:id="@+id/action_showTranslated_to_recordTranslation"
            app:destination="@id/recordTranslation" />
    </fragment>
    <fragment
        android:id="@+id/recordTranslation"
        android:name="com.example.translatelanguages.RecordTranslation"
        android:label="fragment_record_translation"
        tools:layout="@layout/fragment_record_translation" >
        <action
            android:id="@+id/action_recordTranslation_to_showTranslated"
            app:destination="@id/showTranslated" />
    </fragment>
</navigation>